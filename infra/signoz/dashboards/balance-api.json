        "clickhouse_sql": [
          {
            "disabled": false,
            "legend": "found",
            "name": "A",
            "query": "SELECT\n  toStartOfInterval(toDateTime(intDiv(unix_milli, 1000)), INTERVAL 60 SECOND) AS ts,\n  sum(value) / 60 AS value\nFROM signoz_metrics.distributed_samples_v4\nINNER JOIN (\n  SELECT DISTINCT fingerprint\n  FROM signoz_metrics.time_series_v4\n  WHERE metric_name = 'balance.queries'\n    AND JSONExtractString(labels, 'service.name') = 'itau-balance-api'\n    AND JSONExtractString(labels, 'result') = 'found'\n) AS fps USING fingerprint\nWHERE metric_name = 'balance.queries'\n  AND unix_milli >= toUnixTimestamp(now() - INTERVAL 6 HOUR) * 1000\nGROUP BY ts\nORDER BY ts ASC"
          }
        ],
